{
    "name": "chat-backend",
    "version": "1.0.0",
    "description": "WhatsApp-like chat backend with AI chat (Hapi + Prisma + MySQL)",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "NODE_ENV=development nodemon --watch src --exec node src/server.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev --name init",
        "test": "jest --runInBand",
        "lint": "eslint . --ext .js"
    },
    "author": "Senior Backend Architect",
    "license": "MIT",
    "dependencies": {
        "@hapi/hapi": "^21.0.0",
        "@hapi/inert": "^7.1.0",
        "@hapi/vision": "^7.0.3",
        "@prisma/client": "^5.0.0",
        "axios": "^1.4.0",
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.0.0",
        "google-auth-library": "^9.0.0",
        "hapi-auth-jwt2": "^10.2.0",
        "hapi-swagger": "^16.0.0",
        "jsonwebtoken": "^9.0.0",
        "mysql2": "^3.3.0",
        "prisma": "^5.0.0",
        "uuid": "^9.0.0",
        "winston": "^3.8.2"
    },
    "devDependencies": {
        "eslint": "^8.50.0",
        "jest": "^29.6.0",
        "nodemon": "^3.0.1",
        "supertest": "^6.3.4"
    }
}
